{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 600,
    "height": 600,
    "background": "white",
    "title":
    {
        "text": "Melbourne: Population Growth by Suburb (1975 - 2025)",
        "fontSize": 16,
        "fontWeight": "bold"
    },
    "config":
    {
        "axis":
        {
            "labelFontSize": 13,
            "titleFontSize": 14,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "legend":
        {
            "titleFontSize": 14,
            "labelFontSize": 13,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "view":
        {
            "stroke": "transparent"
        }
    },
    "layer":
    [
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/suburb_growth.csv",
                "format":
                {
                    "type": "csv"
                }
            },
            "mark":
            {
                "type": "point",
                "filled": true,
                "size": 80
            },
            "encoding":
            {
                "x":
                {
                    "field": "nominal_growth",
                    "type": "quantitative",
                    "title": "Nominal Growth (#)",
                    "scale":
                    {
                        "type": "symlog",
                        "constant": 1000,
                        "domain": [0, 165000]
                    },
                    "axis":
                    {
                        "values":
                        [
                            -2000, -800, 0,
                            800, 2000, 4000,
                            8000, 16000, 32000, 64000,
                            128000
                        ],
                        "grid": true    
                    }
                },
                "y":
                {
                    "field": "pct_growth",
                    "type": "quantitative",
                    "title": "Percentage Growth (%)",
                    "scale":
                    {
                        "type": "symlog",
                        "constant": 1.5,
                        "domain": [0, 155000]
                    },
                    "axis":
                    {
                        "values":
                        [
                            -10, -5, -2, 0,
                            2, 5, 10, 20,
                            50, 100, 200, 500,
                            1000, 2000, 5000, 10000,
                            20000, 50000, 100000
                        ],
                        "grid": true
                    }
                },
                "color":
                {
                    "field": "region_type",
                    "type": "nominal",
                    "title": "Region Type",
                    "legend":
                    {
                        "orient": "none",
                        "legendX": 100,
                        "legendY": 100
                    },
                    "scale":
                    {
                        "domain":
                        [
                            "Rural",
                            "Outer Suburban",
                            "Inner Suburban",
                            "Urban"
                        ],
                        "range": ["#ff0000", "#ffb300", "#63cce0", "#0000ff"]

                    }
                },
                "tooltip":
                [
                    {
                        "field": "suburb",
                        "type": "nominal",
                        "title": "Suburb"
                    },
                    {
                        "field": "nominal_growth",
                        "type": "quantitative",
                        "title": "Total Growth (#)"
                    },
                    {
                        "field": "pct_growth",
                        "type": "quantitative",
                        "title": "Percent Growth (%)",
                        "format": ".2f"
                    },
                    {
                        "field": "region_type",
                        "type": "nominal",
                        "title": "Region Type"
                    }
                ]
            }
        },
            {
            "data": {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/suburb_growth.csv",
                "format":
                {
                    "type": "csv"
                }
            },
            "transform":
            [
                {
                    "filter": "indexof(['Docklands', 'Point Cook', 'Cranbourne East', 'Melbourne', 'Southbank', 'Carlton', 'Mitcham', 'Clayton', 'Pakenham'], datum.suburb) >= 0"
                }
            ],
            "mark": {
                "type": "text",
                "align": "right",
                "baseline": "middle",
                "dx": -5,
                "dy": -5,
                "fontSize": 13,
                "font": "Calibri",
                "color": "black"
            },
            "encoding":
            {
                "x":
                {
                    "field": "nominal_growth",
                    "type": "quantitative"
                },
                "y":
                {
                    "field": "pct_growth",
                    "type": "quantitative"
                },
                "text":
                {
                    "field": "suburb",
                    "type": "nominal"
                }
            }
            }
    ]
}
