{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 550,
    "height": 600,
    "background": "white",
    "title":
    {
        "text": "Melbourne: Population Growth by Suburb (1975 - 2025)",
        "fontSize": 20,
        "font": "Calibri",
        "fontWeight": "bold"
    },
    "config":
    {
        "axis":
        {
            "labelFontSize": 14,
            "titleFontSize": 14,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "legend":
        {
            "labelFontSize": 14,
            "titleFontSize": 14,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "view":
        {
            "stroke": "transparent"
        }
    },
    "layer":
    [
        {
            "params":
            [
                {
                    "name": "region_select",
                    "select":
                    {
                        "type": "point",
                        "fields": ["region_type"],
                        "on": "click",
                        "clear": "false",
                        "toggle": "true"
                    }
                }
            ],
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/suburb_growth.csv",
                "format":
                {
                    "type": "csv"
                }
            },
            "mark":
            {
                "type": "point",
                "filled": true,
                "size": 80
            },
            "encoding":
            {
                "x":
                {
                    "field": "nominal_growth",
                    "type": "quantitative",
                    "title": "Nominal Growth (#)",
                    "scale":
                    {
                        "type": "symlog",
                        "constant": 1000,
                        "domain": [0, 165000]
                    },
                    "axis":
                    {
                        "values":
                        [
                            0,
                            500, 1000, 2000, 4000,
                            8000, 16000, 32000, 64000,
                            128000, 144591
                        ],
                        "grid": true    
                    }
                },
                "y":
                {
                    "field": "pct_growth",
                    "type": "quantitative",
                    "title": "Percentage Growth (%)",
                    "scale":
                    {
                        "type": "symlog",
                        "constant": 1.5,
                        "domain": [0, 155000]
                    },
                    "axis":
                    {
                        "values":
                        [
                            0, 5, 20,
                            100, 500,
                            2000, 10000,
                            50000, 112467
                        ],
                        "grid": true
                    }
                },
                "color":
                {
                    "field": "region_type",
                    "type": "nominal",
                    "title": "Region Type",
                    "legend":
                    {
                        "orient": "none",
                        "legendX": 80,
                        "legendY": 100,
                        "strokeColor": "#ccc",
                        "fillColor": "white",
                        "cornerRadius": 10,
                        "padding": 10
                    },
                    "scale":
                    {
                        "domain":
                        [
                            "Rural",
                            "Outer Suburban",
                            "Inner Suburban",
                            "Urban"
                        ],
                        "range": ["#ff0000", "#ffb300", "#63cce0", "#0000ff"]

                    }
                },
                "tooltip":
                [
                    {
                        "field": "suburb",
                        "type": "nominal",
                        "title": "Suburb"
                    },
                    {
                        "field": "nominal_growth",
                        "type": "quantitative",
                        "title": "Total Growth (#)"
                    },
                    {
                        "field": "pct_growth",
                        "type": "quantitative",
                        "title": "Percent Growth (%)",
                        "format": ".2f"
                    },
                    {
                        "field": "region_type",
                        "type": "nominal",
                        "title": "Region Type"
                    }
                ],
                "opacity":
                {
                    "condition":
                    {
                        "param": "region_select",
                        "value": 1
                    },
                    "value": 0.2
                }
            }
        },
            {
            "data": {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/suburb_growth.csv",
                "format":
                {
                    "type": "csv"
                }
            },
            "transform":
            [
                {
                    "filter": "indexof(['Docklands', 'Point Cook', 'Cranbourne East', 'Melbourne', 'Southbank', 'Carlton', 'Mitcham', 'Clayton', 'Pakenham', 'Frankston'], datum.suburb) >= 0"
                }
            ],
            "mark": {
                "type": "text",
                "align": "right",
                "baseline": "middle",
                "dx": -7,
                "dy": -5,
                "fontSize": 14,
                "font": "Calibri",
                "color": "black"
            },
            "encoding":
            {
                "x":
                {
                    "field": "nominal_growth",
                    "type": "quantitative"
                },
                "y":
                {
                    "field": "pct_growth",
                    "type": "quantitative"
                },
                "text":
                {
                    "field": "suburb",
                    "type": "nominal"
                }
            }
        },
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/suburb_growth.csv",
                "format":
                {
                    "type": "csv"
                }
            },
            "transform":
            [
                {
                "filter": "indexof(['Docklands', 'Point Cook', 'Cranbourne East', 'Melbourne', 'Southbank', 'Carlton', 'Mitcham', 'Clayton', 'Pakenham', 'Frankston'], datum.suburb) >= 0"
                }
            ],
            "mark":
            {
                "type": "point",
                "filled": false,
                "size": 100,
                "stroke": "black",
                "strokeWidth": 1
            },
            "encoding":
            {
                "x":
                {
                    "field": "nominal_growth",
                    "type": "quantitative"
                },
                "y":
                {
                    "field": "pct_growth",
                    "type": "quantitative"
                },
                "tooltip":
                [
                    {
                        "field": "suburb",
                        "type": "nominal",
                        "title": "Suburb"
                    },
                    {
                        "field": "nominal_growth",
                        "type": "quantitative",
                        "title": "Total Growth (#)"
                    },
                    {
                        "field": "pct_growth",
                        "type": "quantitative",
                        "title": "Percent Growth (%)",
                        "format": ".2f"
                    },
                    {
                        "field": "region_type",
                        "type": "nominal",
                        "title": "Region Type"
                    }
                ]
            }
        }
    ]
}
