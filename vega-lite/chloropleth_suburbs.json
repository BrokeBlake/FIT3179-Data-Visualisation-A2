{
	"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
	"width": 600,
	"height": 500,
    "background": "null",
    "title":
    {
        "text": "Melbourne: Population Density by Suburb (1975-2030)",
        "fontSize": 16,
        "fontWeight": "bold"
    },
    "config":
    {
        "axis":
        {
            "labelFontSize": 12,
            "titleFontSize": 13
        },
        "legend":
        {
            "titleFontSize": 13,
            "labelFontSize": 12
        },
        "view":
        {
            "stroke": "transparent"
        }
    },

    "projection":
    {
        "type": "mercator",
        "scale": 32000,
        "center": [145, -37.875]
        
    },
    "params":
    [
        {
            "name": "selectedyear",
            "value": 2025
        }
    ],
    "layer":
    [
        {
            "data":
            {
                "sphere": true
            },
            "mark":
            {
                "type": "geoshape",
                "fill": "#e1eaf2",
                "stroke": "white"
            }
        },
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/vic_suburb_boundaries_topojson.json",
                "format":
                {
                    "type": "topojson",
                    "feature": "vic_suburb_boundaries"
                }
            },
            "transform":
            [
                {
                "calculate": "datum.properties.LOC_NAME + toString(selectedyear)",
                "as": "suburb_year_key"
                },
                {
                    "lookup": "suburb_year_key",
                    "from":
                    {
                        "data":
                        {
                            "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/population_by_suburb.csv"
                        },
                        "key": "key",
                        "fields":
                        [
                            "pop_density", "year", "pop_total", "area_km2"
                        ]
                    }
                }
            ],
            "mark":
            {
                "type": "geoshape",
                "stroke": "black",
                "strokeWidth": 0.25,
                "strokeOpacity": 0.75
            },
            "encoding":
            {
                "color":
                {
                    "field": "pop_density",
                    "type": "quantitative",
                    "title": "Density (pp/km²)",
                    "scale":
                    {
                        "type": "sqrt",
                        "domain": [0, 15000],
                        "clamp": true,
                        "scheme": "lighttealblue"
                    },
                    "legend": 
                    {
                        "values": [0, 1000, 5000, 19530],
                        "orient": "none",
                        "legendX": 160,
                        "legendY": 400,
                        "direction": "horizontal",
                        "gradientLength": 180
                    }
                },
                "tooltip":
                [
                    {
                        "field": "properties.LOC_NAME",
                        "type": "nominal",
                        "title": "Suburb"
                    },
                    {
                        "field": "pop_total",
                        "type": "quantitative",
                        "title": "Total Population"
                    },
                    {
                        "field": "pop_density",
                        "type": "quantitative",
                        "title": "Population Density (pp/km^2)"
                    },
                    {
                        "field": "area_km2",
                        "type": "quantitative",
                        "title": "Area (km^2)"
                    },
                    {
                        "field": "year",
                        "type": "ordinal",
                        "title": "Year"
                    }
                ]
            }
        },
        {
            "data":
            {
                "values":
                [
                    {
                    "lat": -38.02,
                    "lon": 144.75,
                    "label": "Fast growing Outer suburbs"
                    }
            ]   
            },
            "mark":
            {
                "type": "text",
                "fontSize": 14,
                "color": "darkgreen"
            },
            "encoding":
            {
                "longitude":
                {
                    "field": "lon",
                    "type": "quantitative"
                },
                "latitude":
                {
                    "field": "lat",
                    "type": "quantitative"
                },
                "text":
                {
                    "field": "label"
                }
            }
        },
        {
            "data":
            {
                "values":
                [
                    {
                        "lat1": 144.8,
                        "lon1": -37.98,
                        "lat2": 144.74,
                        "lon2": -37.87
                    }
                ]
            },
            "mark":
            {
                "type": "rule",
                "color": "green",
                "strokeWidth": 2
            },
            "encoding":
            {
                "longitude":
                {
                    "field": "lat1",
                    "type": "quantitative"
                },
                "latitude":
                {
                    "field": "lon1",
                    "type": "quantitative"
                },
                "longitude2":
                {
                    "field": "lat2"
                },
                "latitude2":
                {
                    "field": "lon2"
                }
            }
        },
        {
            "data":
            {
                "values":
                [
                    {
                        "lat1": 144.8,
                        "lon1": -37.98,
                        "lat2": 144.76,
                        "lon2": -37.72
                    }
                ]
            },
            "mark":
            {
                "type": "rule",
                "color": "green",
                "strokeWidth": 2
            },
            "encoding":
            {
                "longitude": {"field": "lat1","type": "quantitative"},
                "latitude": {"field": "lon1","type": "quantitative"},
                "longitude2": {"field": "lat2"},
                "latitude2": {"field": "lon2"}
            }
        },
                {
            "data":
            {
                "values":
                [
                    {
                        "lat1": 144.8,
                        "lon1": -37.98,
                        "lat2": 144.76,
                        "lon2": -37.72
                    }
                ]
            },
            "mark":
            {
                "type": "rule",
                "color": "green",
                "strokeWidth": 2
            },
            "encoding":
            {
                "longitude": {"field": "lat1","type": "quantitative"},
                "latitude": {"field": "lon1","type": "quantitative"},
                "longitude2": {"field": "lat2"},
                "latitude2": {"field": "lon2"}
            }
        },
        {
            "data":
            {
                "values":
                [
                    {
                        "lat1": 144.8,
                        "lon1": -37.98,
                        "lat2": 145.29,
                        "lon2": -38.08
                    }
                ]
            },
            "mark":
            {
                "type": "rule",
                "color": "green",
                "strokeWidth": 2
            },
            "encoding":
            {
                "longitude": {"field": "lat1","type": "quantitative"},
                "latitude": {"field": "lon1","type": "quantitative"},
                "longitude2": {"field": "lat2"},
                "latitude2": {"field": "lon2"}
            }
        },
        {
            "data":
            {
                "values":
                [
                    {
                    "lat": -37.71,
                    "lon": 145,
                    "label": "Inner City Urbanisation"
                    }
            ]   
            },
            "mark":
            {
                "type": "text",
                "fontSize": 14,
                "color": "yellow"
            },
            "encoding":
            {
                "longitude":
                {
                    "field": "lon",
                    "type": "quantitative"
                },
                "latitude":
                {
                    "field": "lat",
                    "type": "quantitative"
                },
                "text":
                {
                    "field": "label"
                }
            }
        },
        {
            "data":
            {
                "values":
                [
                    {
                        "lat1": 144.96,
                        "lon1": -37.72,
                        "lat2": 144.95,
                        "lon2": -37.82
                    }
                ]
            },
            "mark":
            {
                "type": "rule",
                "color": "yellow",
                "strokeWidth": 2
            },
            "encoding":
            {
                "longitude": {"field": "lat1","type": "quantitative"},
                "latitude": {"field": "lon1","type": "quantitative"},
                "longitude2": {"field": "lat2"},
                "latitude2": {"field": "lon2"}
            }
        }
    ]
}
