{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 700,
    "height": 600,
    "background": "null",
    "title":
    {
        "text": "Melbourne: Built-up Land (1975 - 2030)",
        "fontSize": 16,
        "fontWeight": "bold"
    },
    "config":
    {
        "axis":
        {
            "labelFontSize": 13,
            "titleFontSize": 14,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "legend":
        {
            "labelFontSize": 13,
            "titleFontSize": 14,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "view":
        {
            "stroke": "transparent"
        }
    },
    
    "projection":
    {
        "type": "mercator",
        "scale": 40000,
        "center":
        [
            145,
            -37.875
        ]
        
    },
    
    "layer":
    [
        {
            "data":
            {
                "sphere": true
            },
            "mark":
            {
                "type": "geoshape",
                "fill": "#e1eaf2",
                "stroke": "white"
            }
        },
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/vic_suburb_boundaries_topojson.json",
                "format":
                {
                    "type": "topojson",
                    "feature": "vic_suburb_boundaries"
                }
            },
            "mark":
            {
                "type": "geoshape",
                "stroke": "white",
                "strokeWidth": 0.5
            },            
            "encoding":
            {
                "color":
                {
                    "value": "#eeeeee" 
                }
            }
        },
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/builtup_point_data.csv"
            },
            "mark":
            {
                "type": "rect",
                "width": 3,
                "height": 3.6
            },
            "encoding":
            {
                "longitude":
                {
                    "field": "x",
                    "type": "quantitative"
                },
                "latitude":
                {
                    "field": "y",
                    "type": "quantitative"
                },
                "color":
                {
                    "field": "year",
                    "type": "ordinal",
                    "scale":
                    {
                        "scheme":
                        {
                            "name": "goldgreen"
                        },
                        "reverse": false
                    },
                    "legend":
                    {
                        "title": "Year Considered Developed: ",
                        "orient": "none",
                        "legendX": 155,
                        "legendY": 425,
                        "direction": "horizontal",
                        "columns": 4,
                        "gradientLength": 180,
                        "strokeColor": "#ccc",
                        "fillColor": "whitesmoke",
                        "cornerRadius": 10,
                        "padding": 10
                    }
                },
                "tooltip":
                [
                    {
                        "field": "x",
                        "type": "quantitative",
                        "title": "Longtitude"
                    },
                    {
                        "field": "y",
                        "type": "quantitative",
                        "title": "Latitude"
                    },
                    {
                        "field": "year",
                        "type": "quantitative",
                        "title": "Year considered developed"
                    }
                ]
            }
        },
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/vic_rivers.geojson"
            },
            "mark":
            {
                "type": "geoshape",
                "fill": null,
                "stroke": "#e1eaf2",
                "strokeWidth": 3
            }
        },
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/melbourne_rivers.json",
                "format":
                {
                    "type": "topojson",
                    "feature": "Catchments_-_Major_River_Basins_Melbourne"
                }
            },
            
            "mark":
            {
                "type": "geoshape",
                "fill": null,
                "stroke": "#e1eaf2",
                "strokeWidth": 2
            }
        },
        {
            "data":
            {
                "values":
                [
                    {
                    "lat": -37.76,
                    "lon": 145.05,
                    "label": "Yarra River"
                    }
            ]   
            },
            "mark":
            {
                "type": "text",
                "fontSize": 13,
                "color": "black",
                "angle": 332,
                "font": "Calibri"
            },
            "encoding":
            {
                "longitude":
                {
                    "field": "lon",
                    "type": "quantitative"
                },
                "latitude":
