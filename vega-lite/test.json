{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 700,
    "height": 600,
    "background": "null",
    "title":
    {
        "text": "Melbourne: Built-up Land (1975-2030)",
        "fontSize": 16,
        "fontWeight": "bold"
    },
    "config":
    {
        "axis":
        {
            "labelFontSize": 12,
            "titleFontSize": 13
        },
        "legend":
        {
            "titleFontSize": 13,
            "labelFontSize": 12
        },
        "view":
        {
            "stroke": "transparent"
        }
    },
    
    "projection":
    {
        "type": "mercator",
        "scale": 40000,
        "center":
        [
            145,
            -37.875
        ]
        
    },
    
    "layer":
    [
        {
            "data":
            {
                "sphere": true
            },
            "mark":
            {
                "type": "geoshape",
                "fill": "lightblue",
                "stroke": "white"
            }
        },
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/vic_suburb_boundaries_topojson.json",
                "format":
                {
                    "type": "topojson",
                    "feature": "vic_suburb_boundaries"
                }
            },
            "mark":
            {
                "type": "geoshape",
                "stroke": "white",
                "strokeWidth": 0.5
            },            
            "encoding":
            {
                "color":
                {
                    "value": "#eeeeee" 
                }
            }
        },
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/builtup_point_data.csv"
            },
            "mark":
            {
                "type": "rect",
                "width": 3,
                "height": 3.6
            },
            "encoding":
            {
                "longitude":
                {
                    "field": "x",
                    "type": "quantitative"
                },
                "latitude":
                {
                    "field": "y",
                    "type": "quantitative"
                },
                "color":
                {
                    "field": "year",
                    "type": "ordinal",
                    "scale":
                    {
                        "scheme":
                        {
                            "name": "goldgreen"
                        },
                        "reverse": false
                    },
                    "legend":
                    {
                        "title": "Year Considered Developed: ",
                        "orient": "none",
                        "legendX": 160,
                        "legendY": 420,
                        "direction": "horizontal",
                        "columns": 4,
                        "gradientLength": 180
                    }
                },
                "tooltip":
                [
                    {
                        "field": "x",
                        "type": "quantitative",
                        "title": "Longtitude"
                    },
                    {
                        "field": "y",
                        "type": "quantitative",
                        "title": "Latitude"
                    },
                    {
                        "field": "year",
                        "type": "quantitative",
                        "title": "Year considered developed"
                    }
                ]
            }
        },
        {
            "data":
            {
                "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/vic_rivers.geojson"
            },
            "mark":
            {
                "type": "geoshape",
                "fill": null,
                "stroke": "lightblue",
                "strokeWidth": 2
            }
        }
    ]
}