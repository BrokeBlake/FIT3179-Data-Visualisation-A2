{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 700,
    "height": 500,
    "title":
    {
        "text": "Global Cities: Population vs Population Density",
        "fontSize": 20,
        "anchor": "start"
    },
    "config":
    {
        "axis":
        {
            "labelFontSize": 12,
            "titleFontSize": 13
        },
        "legend":
        {
            "titleFontSize": 13,
            "labelFontSize": 12
        }
    },
    "data":
        {
        "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/population_density_2025.csv"
        },
    "mark":
    {
        "type": "point",
        "filled": true,
        "size": 125,
        "opacity": 0.75
    },
    "transform":
    [
        {
            "calculate": "datum.Population / 1000000",
            "as":
            "Population_millions"
        }
    ],
    "encoding":
    {
        "x":
        {
            "field": "Population_Density",
            "type": "quantitative",
            "title": "Population Density (people per km²)",
            "scale":
            {
                "type": "linear"
            }
        },
        "y":
        {
            "field": "Population_millions",
            "type": "quantitative",
            "title": "Total Population (Millions)",
            "scale":
            {
                "type": "linear"
            }
        },
        "color":
        {
            "field": "Region",
            "type": "nominal",
            "title": "Region"
        },
        "tooltip":
        [
            {
                "field": "City",
                "type": "nominal"
            },
            {
                "field": "Country",
                "type": "nominal"
            },
            {
                "field": "Region",
                "type": "nominal"
            },
            {
                "field": "Population_Density",
                "type": "quantitative",
                "title": "Density (pp / km²)"
            },
            {
                "field": "Population",
                "type": "quantitative",
                "title": "Total Population",
                "format": ",.0f"
            }
        ]
    }
}
