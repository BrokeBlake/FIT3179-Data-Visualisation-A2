{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 550,
    "height": 500,
    "background": "null",
    "title":
    {
        "text": "Global Cities: Population Density",
        "fontSize": 20,
        "font": "Calibri",
        "fontWeight": "bold"

    },
    "config":
    {
        "axis":
        {
            "labelFontSize": 14,
            "titleFontSize": 14,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "legend":
        {
            "labelFontSize": 14,
            "titleFontSize": 14,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "view":
        {
            "stroke": "transparent"
        }
    },
    "data":
    {
        "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/population_density_2025.csv",
        "format":
        {
            "type": "csv",
            "parse": { "Population_Density": "number" }
        }
    },
    "layer":
    
    [
        {
            "transform":
            [
                {
                    "filter": "indexof(['Mumbai','Kinshasa','Hong Kong','New Delhi','Singapore','Istanbul','Shanghai','Moscow','Jakarta','Beijing','Mexico City','Paris','Tokyo','London','Osaka','Dhaka', 'Sydney', 'Melbourne', 'Chicago', 'New York City', 'Chongqing', 'Toronto', 'Los Angeles', 'Dubai', 'Amsterdam', 'Cairo', 'Johannesburg', 'Miami'], datum.City) >= 0"
                }
            ],
            "mark":
            {
                "type": "bar"
            },
            "encoding":
            {
                "x":
                {
                    "field": "Population_Density",
                    "type": "quantitative",
                    "title": "Population Density (people per km²)",
                    "scale":
                    {
                        "type": "linear",
                        "domain": [0, 32000]
                    }
                },
                "y":
                {
                    "field": "City",
                    "type": "nominal",
                    "title": null,
                    "sort":
                    {
                        "field": "Population_Density",
                        "op": "max",
                        "order": "descending"
                    },
                    "axis":
                    {
                        "labels": false,
                        "ticks": false
                    }
                },
                "color":
                {
                    "field": "Region",
                    "type": "nominal",
                    "title": "Region",
                    "scale":
                    {
                        "domain": ["East Asia & Pacific", "Europe & Central Asia", "Latin America & Caribbean", "Middle East & North Africa", "North America", "South Asia", "Sub-Saharan Africa"],
                        "range": ["#4E79A7", "#F28E2B", "#76B7B2", "#59A14F", "#B07AA1", "#EDC948", "#9C755F"]
                    },
                    "legend":
                    {
                        "orient": "none",
                        "legendX": 340,
                        "legendY": 320,
                        "strokeColor": "#ccc",
                        "fillColor": "white",
                        "cornerRadius": 10,
                        "padding": 10
                    }
                },
                "tooltip":
                [
                    {
                        "field": "City",
                        "type": "nominal"
                    },
                    {
                        "field": "Country",
                        "type": "nominal"
                    },
                    {
                        "field": "Region",
                        "type": "nominal"
                    },
                    {
                        "field": "Population_Density",
                        "type": "quantitative",
                        "title": "Density (pp / km²)"
                    },
                    {
                        "field": "Population",
                        "type": "quantitative",
                        "title": "Total Population",
                        "format": ",.0f"
                    }
                ]
            }
        },
        {
            "transform":
            [
                {
                    "filter": "indexof(['Mumbai','Kinshasa','Hong Kong','New Delhi','Singapore','Istanbul','Shanghai','Moscow','Jakarta','Beijing','Mexico City','Paris','Tokyo','London','Osaka','Dhaka', 'Sydney', 'Melbourne', 'Chicago', 'New York City', 'Chongqing', 'Toronto', 'Los Angeles', 'Dubai', 'Amsterdam', 'Cairo', 'Johannesburg', 'Miami'], datum.City) >= 0"
                }
            ],
            "mark":
            {
                "type": "text",
                "align": "left",
                "dx": 2,
                "color": "black",
                "fontSize": 14,
                "font": "Calibri"
            },
            "encoding":
            {
                "text":
                {
                    "field": "City"
                },
                "x":
                {
                    "field": "Population_Density",
                    "type": "quantitative"
                },
                "y":
                {
                    "field": "City",
                    "type": "nominal",
                    "sort":
                    {
                        "field": "Population_Density",
                        "op": "max",
                        "order": "descending"
                    }
                }
            }
        }
    ]
}
