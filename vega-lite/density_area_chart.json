{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 600,
    "height": 400,
    "background": "null",
    "title":
    {
        "text": "Melbourne: Population Density Distribution by Class (1975 - 2030)",
        "fontSize": 20,
        "font": "Calibri",
        "fontWeight": "bold"
    },
    "config":
    {
        "axis":
        {
            "labelFontSize": 13,
            "titleFontSize": 14,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "legend":
        {
            "labelFontSize": 13,
            "titleFontSize": 14,
            "labelFont": "Calibri",
            "titleFont": "Calibri",
            "titleFontWeight": "bold"
        },
        "view":
        {
            "stroke": "transparent"
        }
    },
    "data":
    {
        "url": "https://raw.githubusercontent.com/BrokeBlake/FIT3179-Data-Visualisation-A2/main/data/population_density_distribution.csv"
    },
    "mark":
    {
        "type": "area",
        "interpolate": "monotone",
        "line":
        {
            "color": "white",
            "width": 0.1
        }
    },
    "encoding":
    {
        "x":
        {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "axis":
            {
                "labelAngle": 0,
                "format": "d",
                "values":
                [
                    1975, 1980, 1985, 1990,
                    1995, 2000, 2005, 2010,
                    2015, 2020, 2025, 2030
                ]
            }
        },
        "y":
        {
            "aggregate": "sum",
            "field": "proportion",
            "stack": "normalize",
            "type": "quantitative",
            "title": "Proportion of Population",
            "axis":
            {
                "format": ".0%"
            }
        },
        "color":
        {
            "field": "density_bin",
            "type": "ordinal",
            "scale":
            {
                "domain":
                [
                    "10000+","4000-10000",
                    "2000-4000","500-2000",
                    "50-500","0-50"
                ],
                "scheme":
                {
                    "name": "lighttealblue"
                },
                "reverse": true
            },
            "legend": 
            {
                "title": "Density (people/km²)",
                "orient": "bottom",
                "legendX": 200,
                "legendY": 50,
                "strokeColor": "#ccc",
                "fillColor": "white",
                "cornerRadius": 10,
                "padding": 10
            }
        },
        "order":
        {
            "field": "density_order",
            "type": "ordinal"
        },
        "tooltip":
        [
            {
                "field": "year",
                "title": "Year",
                "type": "quantitative"
            },
            {
                "field": "density_bin",
                "title": "Density",
                "type": "nominal"
            },
            {
                "field": "proportion",
                "title": "Proportion",
                "type": "quantitative",
                "format": ".1%"
            }
        ]
    }
}
